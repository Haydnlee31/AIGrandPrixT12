{
  "api_version": "v1",
  "contract_version": "0.4.0",
  "authentication": "development_bearer",
  "capture": {
    "clients": [
      "web",
      "chrome_extension",
      "ios_app",
      "ios_share_extension"
    ],
    "content_types": [
      "url",
      "selected_text",
      "note",
      "image"
    ],
    "max_url_length": 2048,
    "max_title_length": 300,
    "max_selected_text_length": 12000,
    "max_note_length": 2000,
    "max_image_bytes": 4194304
  },
  "data_modes": {
    "annotations": "demo_rules",
    "catalog": "fixture",
    "tracking": "simulated"
  },
  "features": {
    "annotations": true,
    "predictive_prompts": false,
    "product_analysis": false,
    "library_search": true,
    "explore": true,
    "discovery": true,
    "watches": true,
    "price_simulation": true,
    "demo_reset": true,
    "image_upload": true,
    "multimodal_ai": false,
    "contextual_questions": true,
    "retry_understanding": true,
    "multiple_intents": true,
    "legacy_image_data": true,
    "image_data_url": true,
    "live_price_monitoring": false,
    "push_notifications": false,
    "merchant_handoff": false,
    "personal_agent_connector": false,
    "reminder_scheduling": false
  },
  "currencies": [
    "SGD"
  ],
  "refresh": {
    "strategy": "poll_on_foreground",
    "pending_save_interval_ms": 1500,
    "pending_save_timeout_ms": 30000,
    "incremental_sync": false
  }
}
