{
  "manifest_version": 3,
  "name": "Mymah Finds",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "description": "Save links, selected text and notes to your Mymah Finds Library.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_popup": "popup.html", "default_title": "Save to Mymah Finds"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
