# Defaults run locally with SQLite. Use the same settings for API and worker.
DATABASE_URL=sqlite:///./prototype.db
# Local demo only. Replace both tokens before exposing the server.
API_TOKENS={"demo-alex":"alex","demo-sam":"sam"}
DEMO_MODE=true
# Set false for a separate worker process.
EMBEDDED_WORKER=true
# Exact browser origins only; no wildcard. Same-origin demo needs no entry.
CORS_ORIGINS=[]
# Example for a separate web UI: ["http://localhost:5173"]
# Both API and worker must use the same provider configuration.
# demo = honest local fallback; openai = real image/text understanding.
ANNOTATION_PROVIDER=demo
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
