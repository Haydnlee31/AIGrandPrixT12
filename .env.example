# Defaults run locally with SQLite. Use the same settings for API and worker.
DATABASE_URL=sqlite:///./prototype.db
# Local demo only. Replace both tokens before exposing the server.
API_TOKENS={"demo-alex":"alex","demo-sam":"sam"}
DEMO_MODE=true
# Set false for a separate worker process.
EMBEDDED_WORKER=true
# Exact browser origins only; no wildcard. Same-origin demo needs no entry.
CORS_ORIGINS=[]
# Example for a separate web UI: ["http://localhost:5173"]

# Predictive annotations: backend secrets only. No client-side configuration.
# auto uses Astra when either server key exists; otherwise uses local rules.
# Set astra to require configuration (missing key then fails startup).
ANNOTATION_PROVIDER=auto
ASTRA_API_KEY=
# OPENAI_API_KEY is also accepted; ASTRA_API_KEY takes precedence.
ASTRA_MODEL=gpt-6-astra
# default, fast or ultrafast (paid acceleration; availability depends on account).
ASTRA_SERVICE_TIER=default

# Immediate catalog: licensed local datasets; no developer account/API keys required.
# Approved impact/CJ exports are imported locally; no API secret is needed for that path.
# Optional CJ catalog discovery helper (does not grant merchant/feed permissions):
CJ_PERSONAL_ACCESS_TOKEN=
CJ_COMPANY_ID=
